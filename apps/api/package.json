    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@spexs/db": "workspace:*",
    "@spexs/types": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.5.1",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
