    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "@types/toposort": "^2.0.7",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
