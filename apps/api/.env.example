# App
NODE_ENV=development
PORT=3001

# Database — PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/spexs

# Better Auth
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Frontend (CORS + trusted origins)
FRONTEND_URL=http://localhost:3000

# Email (mailtrap)
SEND_EMAILS=false
MAILTRAP_API_KEY=bearer-------
MAILTRAP_INBOX_ID=inbox--------
FROM_EMAIL=hello@spexs
