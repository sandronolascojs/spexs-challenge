{
  "name": "spexs-challenge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "turbo test",
    "prepare": "husky",
    "db:generate": "turbo db:generate --filter=@spexs/db",
    "db:migrate": "turbo db:migrate --filter=@spexs/db",
    "db:push": "turbo db:push --filter=@spexs/db",
    "db:seed": "turbo db:seed --filter=@spexs/db",
    "db:studio": "turbo db:studio --filter=@spexs/db",
    "web": "pnpm --filter @spexs/web",
    "api": "pnpm --filter @spexs/api",
    "db": "pnpm --filter @spexs/db"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "turbo": "^2.8.17"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  }
}
